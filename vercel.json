{
  "version": 2,
  "builds": [
    { "src": "api/all.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "raghav.jpg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/all", "dest": "/api/all.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
